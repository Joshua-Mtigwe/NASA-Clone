# Copy to .env and adjust. Real environment variables override these.
AEGIS_DATABASE_PATH=aegis.db
AEGIS_SEED_DIR=data/seed
AEGIS_TOKEN_TTL_HOURS=12
AEGIS_PBKDF2_ITERATIONS=600000
AEGIS_TEMPLATE_RUN_ID=RUN-DEMO-001
# Comma-separated front-end origins allowed to call the API
AEGIS_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Phase 6: Gemma runs on this machine through Ollama (https://ollama.com), so it works offline.
#   ollama pull gemma3:4b     (once, while online)
AEGIS_GEMMA_URL=http://127.0.0.1:11434
AEGIS_GEMMA_MODEL=gemma3:4b
AEGIS_GEMMA_TIMEOUT_SECONDS=120
# Crew data is only ever sent to this machine. Set true only if the model runs on another trusted host.
AEGIS_GEMMA_ALLOW_REMOTE=false
