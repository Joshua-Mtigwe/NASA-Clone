# npm run dev uses mock fixtures; npm run dev:integrated selects .env.live.
# Set these to live/true for npm run build with a live API reverse proxy.
VITE_API_MODE=live
VITE_API_BASE_URL=
VITE_DEMO_MODE=true
# Optional: a separately hosted chat service; blank uses the Vite proxy.
VITE_MIND_CHAT_URL=
# Main backend and development proxy. Default: 127.0.0.1:8010.
AEGIS_BACKEND_PORT=8010
AEGIS_BACKEND_URL=http://127.0.0.1:8010
AEGIS_AUTH_MODE=open
# AEGIS_PYTHON=/absolute/path/to/venv/bin/python
# AEGIS_DATABASE_PATH=/absolute/path/to/aegis.db
# Backend explanation/Reflective Coach model:
AEGIS_GEMMA_URL=http://127.0.0.1:11434
AEGIS_GEMMA_MODEL=gemma3:4b
AEGIS_GEMMA_TIMEOUT_SECONDS=120
# Mind Companion (genuine inference only; no generated fallback responses):
MIND_CHAT_DEMO_AUTH=true
MIND_CHAT_MODEL_API=ollama
MIND_CHAT_MODEL_URL=http://127.0.0.1:11434
MIND_CHAT_MODEL=gemma3:4b
MIND_CHAT_TIMEOUT_MS=60000
# For a compatible OpenAI inference server, change API and URL above and set:
# MIND_CHAT_MODEL_API_KEY=...
# Server-side secrets must never use a VITE_ prefix.
